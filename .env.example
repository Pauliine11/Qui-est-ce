# Copie ce fichier en .env.local et remplis les valeurs.
# .env.local est ignoré par git : ne commite JAMAIS de vraie clé.

# ── Supabase (dashboard → Settings → API) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://ton-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle-anon-publique
# Clé service role : SERVEUR UNIQUEMENT, contourne la RLS. Jamais côté client.
SUPABASE_SERVICE_ROLE_KEY=cle-service-role

# ── Upstash Redis (console.upstash.com → ta base → REST API) ─────────────────
UPSTASH_REDIS_REST_URL=https://ta-base.upstash.io
UPSTASH_REDIS_REST_TOKEN=token-rest

# ── LLM (analyse des questions, mode Arbitre IA) ─────────────────────────────
# Fournisseur : "anthropic" ou "openai". Prendre un petit modèle rapide.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_API_KEY=cle-api-du-fournisseur

# ── Cloudflare Turnstile (dash.cloudflare.com → Turnstile) ───────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=cle-de-site-publique
TURNSTILE_SECRET_KEY=cle-secrete

# ── Sécurité et budget ───────────────────────────────────────────────────────
# Sel du hachage des IP (>= 16 caractères aléatoires, ex. `openssl rand -hex 16`)
IP_HASH_SALT=remplace-par-32-caracteres-aleatoires
# Coupe-circuit global : nombre max d'appels LLM par jour (compteur Redis)
LLM_DAILY_BUDGET=200
